<?xml version="1.0" encoding="utf-8"?>
<!-- Left palette pill, dark theme: obsidian glass body with a top specular sheen and a white
     refraction rim. Same 3.5dp content padding as the light version (stack padding mode). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list android:paddingMode="stack">
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#E62A1A12" android:startColor="#E63A2216" />
                    <stroke android:width="1dp" android:color="#80FF7428" />
                    <corners android:radius="16dp" />
                    <padding android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:startColor="#26FF7428" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list android:paddingMode="stack">
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#BF1E1E22" android:startColor="#D9161618" />
                    <stroke android:width="1dp" android:color="#1FFFFFFF" />
                    <corners android:radius="16dp" />
                    <padding android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <!-- specular sheen: 30% white at the top edge fading out by the middle -->
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:startColor="#2EFFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
