<?xml version="1.0" encoding="utf-8"?>
<!-- Obsidian liquid glass dialog surface (dark theme): smoked fill, white refraction edge, 20dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#CC1C1C1E" android:startColor="#E618181A" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#14FFFFFF" android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
