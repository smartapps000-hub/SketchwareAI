<?xml version="1.0" encoding="utf-8"?>
<!-- Obsidian liquid-glass card: ambient drop, crisp 1dp rim (#52FFFFFF top -> #0AFFFFFF base), smoked body, top sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item android:top="1.5dp"><shape><solid android:color="#59000000" /><corners android:radius="22dp" /></shape></item>
    <item android:bottom="1.5dp"><shape><gradient android:angle="270" android:startColor="#52FFFFFF" android:endColor="#0AFFFFFF" /><corners android:radius="22dp" /></shape></item>
    <item android:bottom="2.5dp" android:left="1dp" android:right="1dp" android:top="1dp"><shape><gradient android:angle="270" android:startColor="#E6232328" android:endColor="#D918181C" /><corners android:radius="21dp" /></shape></item>
    <item android:bottom="2.5dp" android:left="1dp" android:right="1dp" android:top="1dp"><shape><gradient android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" /><corners android:radius="21dp" /></shape></item>
</layer-list>
