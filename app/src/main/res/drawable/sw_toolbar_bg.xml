<?xml version="1.0" encoding="utf-8"?>
<!-- Light: Titanium Orange bar with a top sheen and a hairline base. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><gradient android:angle="270" android:startColor="#FFF4511E" android:endColor="#FFEA4A1A" /></shape></item>
    <item android:bottom="1dp"><shape><gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" /></shape></item>
    <item android:top="-2dp" android:left="-2dp" android:right="-2dp"><shape><stroke android:width="1dp" android:color="#26000000" /></shape></item>
</layer-list>
