<?xml version="1.0" encoding="utf-8"?>
<!-- Crash-screen glass: plain shape (no custom drawable class), so the crash report can always draw. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="315" android:startColor="#FFF4511E" android:endColor="#FFFFB619" />
    <stroke android:width="1dp" android:color="#73FFFFFF" />
    <corners android:radius="14dp" />
</shape>
