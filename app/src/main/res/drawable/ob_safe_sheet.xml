<?xml version="1.0" encoding="utf-8"?>
<!-- Crash-screen glass: plain shape (no custom drawable class), so the crash report can always draw. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="270" android:startColor="#E62A2A30" android:endColor="#E6161619" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
    <corners android:radius="26dp" />
</shape>
