<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.0 and older fallback for the glass surface of the same name (drawable-v24). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape>
            <gradient android:angle="315" android:startColor="#FFF4511E" android:endColor="#FFFF7428" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
