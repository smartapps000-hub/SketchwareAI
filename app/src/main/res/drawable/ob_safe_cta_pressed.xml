<?xml version="1.0" encoding="utf-8"?>
<!-- Crash-screen glass: plain shape (no custom drawable class), so the crash report can always draw. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="315" android:startColor="#FFC83D13" android:endColor="#FFBC4A12" />
    <stroke android:width="1dp" android:color="#80FFFFFF" />
    <corners android:radius="16dp" />
</shape>
