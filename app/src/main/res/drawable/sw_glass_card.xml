<?xml version="1.0" encoding="utf-8"?>
<!-- Light liquid-glass card: soft drop, crisp 1dp specular rim (bright top, faint orange base), frosted body, top sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item android:top="1.5dp"><shape><solid android:color="#14000000" /><corners android:radius="22dp" /></shape></item>
    <item android:bottom="1.5dp"><shape><gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#26F4511E" /><corners android:radius="22dp" /></shape></item>
    <item android:bottom="2.5dp" android:left="1dp" android:right="1dp" android:top="1dp"><shape><gradient android:angle="270" android:startColor="#F7FFFFFF" android:endColor="#EBFBF8F6" /><corners android:radius="21dp" /></shape></item>
    <item android:bottom="2.5dp" android:left="1dp" android:right="1dp" android:top="1dp"><shape><gradient android:angle="270" android:startColor="#66FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" /><corners android:radius="21dp" /></shape></item>
</layer-list>
