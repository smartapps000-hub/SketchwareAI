<?xml version="1.0" encoding="utf-8"?>
<!-- Left palette item (Layouts / AndroidX / Widgets): iOS-style pill card.
     Replaces the old 9-patch; the 3.5dp padding matches the 9-patch's content padding so the
     palette keeps its exact item sizes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <!-- #FFFDFB with a 8% (#15) Titanium Orange wash, flattened so the padding stays equal -->
                    <solid android:color="#FEEFE9" />
                    <stroke android:width="1dp" android:color="#40F4511E" />
                    <corners android:radius="14dp" />
                    <padding android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFDFB" />
                    <stroke android:width="1dp" android:color="#1AF4511E" />
                    <corners android:radius="14dp" />
                    <padding android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
