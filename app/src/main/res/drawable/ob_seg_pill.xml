<?xml version="1.0" encoding="utf-8"?>
<!-- Segment pill (Basic / Recent / Event of the view property panel): deeper orange (ob_seg_pill_on, v1.9.7.1) with the white label when selected,
     dark glass otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="90" android:exitFadeDuration="220">
    <item android:state_selected="true" android:drawable="@drawable/ob_seg_pill_on" />
    <item android:state_pressed="true" android:drawable="@drawable/ob_pill_pressed" />
    <item android:drawable="@drawable/ob_pill" />
</selector>
