<?xml version="1.0" encoding="utf-8"?>
<!-- Sketchware AI "liquid glass" dialog surface: frosted white gradient, orange-tinted outer
     rim and a white specular inner edge, 20dp corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D9F8F9FA"
                android:startColor="#F2FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#33FF6F00" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="1.2dp"
        android:left="1.2dp"
        android:right="1.2dp"
        android:top="1.2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
