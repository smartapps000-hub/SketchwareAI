<?xml version="1.0" encoding="utf-8"?>
<!-- Crash-screen glass: plain shape (no custom drawable class), so the crash report can always draw. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="270" android:startColor="#40FF7A29" android:endColor="#1AFF7A29" />
    <stroke android:width="1dp" android:color="#99FF9A4D" />
    <corners android:radius="16dp" />
</shape>
