<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="180">
    <item android:state_pressed="true">
        <layer-list android:paddingMode="stack">
            <item><shape><gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#80F4511E" /><corners android:radius="16dp" /></shape></item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp"><shape><gradient android:angle="270" android:startColor="#FFFFE4D6" android:endColor="#FFFFD2BD" /><corners android:radius="15dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list android:paddingMode="stack">
            <item><shape><gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#26F4511E" /><corners android:radius="16dp" /></shape></item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp"><shape><gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#F2FFF4EE" /><corners android:radius="15dp" /></shape></item>
        </layer-list>
    </item>
</selector>
