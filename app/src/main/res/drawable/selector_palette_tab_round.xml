<?xml version="1.0" encoding="utf-8"?>
<!-- Palette tabs (widgets / favourites): rounded pills inset inside the glass column, so no
     square corner can poke past its rounded edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="2dp" android:insetTop="1dp" android:insetRight="2dp" android:insetBottom="2dp">
            <shape>
                <gradient android:angle="0" android:endColor="#FFFF9A4D" android:startColor="#FFF4511E" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="2dp" android:insetTop="1dp" android:insetRight="2dp" android:insetBottom="2dp">
            <shape>
                <solid android:color="#1FFFFFFF" />
                <stroke android:width="1dp" android:color="#14FFFFFF" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
</selector>
