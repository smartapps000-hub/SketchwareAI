<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile press: a damped 3% sink with a short lift back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:duration="220" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:duration="220" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:duration="220" android:propertyName="translationZ" android:valueTo="2dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
