<?xml version="1.0" encoding="utf-8"?>
<!-- Obsidian liquid glass text styles (design canvas "Sketchware AI Liquid Glass"). -->
<resources>
    <style name="Ob" />
    <style name="Ob.Text">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textColor">@color/ob_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Ob.Text.Brand">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="Ob.Text.Screen">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Ob.Text.Sheet">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Ob.Text.Title">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Ob.Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ob_text_4</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Ob.Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ob_text_2</item>
    </style>
    <style name="Ob.Text.Label">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Ob.Text.Button">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Ob.Text.Button.Cta">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <style name="Ob.Text.Mono">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Ob.IconPill">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/ob_pill_state</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/ob_text</item>
        <item name="android:stateListAnimator">@animator/sw_press</item>
    </style>
    <!-- Floating label of a glass text field (TextInputLayout). -->
    <style name="Ob.FieldLabel" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/ob_text_2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>
    <style name="Ob.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/ob_field</item>
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/ob_text</item>
        <item name="android:textColorHint">@color/ob_text_2</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Ob.ToolbarTitle" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ob_text</item>
    </style>
    <style name="Ob.ToolbarSubtitle" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ob_text_2</item>
    </style>
    <!-- VIEW / EVENT / COMPONENT inside the glass header: amber selected label, 2dp amber bar. -->
    <style name="Ob.EditorTabs" parent="@style/Widget.Design.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabGravity">fill</item>
        <item name="tabMode">fixed</item>
        <item name="tabMaxWidth">0dp</item>
        <item name="tabIndicatorColor">#FFFF7A29</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabSelectedTextColor">@color/ob_accent</item>
        <item name="tabTextColor">@color/ob_text_2</item>
        <item name="tabTextAppearance">@style/Ob.EditorTabText</item>
        <item name="tabRippleColor">#1FFFFFFF</item>
    </style>
    <style name="Ob.EditorTabText" parent="@style/TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">true</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Ob.SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/ob_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/ob_sheet_out</item>
    </style>
    <!-- Bottom sheet window: clear, dimmed behind, full width at the bottom. -->
    <style name="Ob.SheetDialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowAnimationStyle">@style/Ob.SheetAnimation</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
