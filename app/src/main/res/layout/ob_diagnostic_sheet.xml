<?xml version="1.0" encoding="utf-8"?>
<!-- Sketchware AI Diagnostic: sliding liquid-glass bottom sheet
     (design canvas board "Compile log + AI diagnostic"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ob_glass_bottom_sheet"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ob_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 44dp AI tile; 8dp larger each side for its glow. -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginLeft="-8dp"
            android:background="@drawable/ob_tile_ai"
            android:contentDescription="@null"
            android:padding="17dp"
            android:src="@drawable/ob_ic_spark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ob.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_bold"
                android:maxLines="1"
                android:text="Build Doctor"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ob_diag_subtitle"
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ob_diag_history"
            style="@style/Ob.Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/ob_pill16_state"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:stateListAnimator="@animator/sw_press"
            android:text="History"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- The sheet doesn't clip its children (glows), so this frame keeps scrolled text inside. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipChildren="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="14dp"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ob_diag_first_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ob_accent_box"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/ob_diag_first_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_extrabold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:text="CURRENT PROBLEM"
                    android:textColor="@color/ob_accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/ob_diag_title"
                    style="@style/Ob.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope_bold"
                    android:lineSpacingMultiplier="1.12"
                    android:textColor="@color/ob_text"
                    android:textIsSelectable="true"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/ob_diag_first_error"
                    style="@style/Ob.Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- RESULT: fixed or not, and what building again would do. -->
            <TextView
                android:id="@+id/ob_diag_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/ob_dashed_box"
                android:fontFamily="@font/manrope_medium"
                android:lineSpacingMultiplier="1.12"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp"
                android:textColor="@color/ob_text_3"
                android:textSize="12sp" />

            <!-- WHAT I FOUND: the failed step's own findings and known-pattern advice. -->
            <TextView
                android:id="@+id/ob_diag_found_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope_extrabold"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="WHAT I FOUND"
                android:textColor="@color/ob_text_2"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/ob_diag_advice"
                style="@style/Ob.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:textIsSelectable="true"
                android:textSize="12.5sp" />

            <!-- One card per resource that is not on the phone (ob_diagnostic_resource), filled in code. -->
            <LinearLayout
                android:id="@+id/ob_diag_resources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- One card per repair that can be stored in a block (ob_diagnostic_fix), filled in code. -->
            <LinearLayout
                android:id="@+id/ob_diag_fixes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- One card per Java compiler error (ob_diagnostic_problem), filled in code. -->
            <LinearLayout
                android:id="@+id/ob_diag_problems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- WHAT CHANGED: one card per thing the build repaired by itself (ob_diagnostic_change). -->
            <TextView
                android:id="@+id/ob_diag_changes_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope_extrabold"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="WHAT THIS BUILD CHANGED"
                android:textColor="@color/ob_text_2"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ob_diag_changes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- BUILD STEPS: the build map as a timeline. -->
            <TextView
                android:id="@+id/ob_diag_steps_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope_extrabold"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="BUILD STEPS"
                android:textColor="@color/ob_text_2"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ob_diag_steps"
                style="@style/Ob.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.25"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ob_diag_copy"
            style="@style/Ob.Text.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ob_pill16_state"
            android:stateListAnimator="@animator/sw_press"
            android:maxLines="1"
            android:text="Copy log"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/ob_diag_primary_slot"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/ob_diag_primary"
                style="@style/Ob.Text.Button.Cta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="-9dp"
                android:layout_marginTop="-9dp"
                android:layout_marginRight="-9dp"
                android:layout_marginBottom="-9dp"
                android:background="@drawable/ob_cta_state"
                android:stateListAnimator="@animator/sw_press"
                android:maxLines="1"
                android:text="Build again"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
