<?xml version="1.0" encoding="utf-8"?>
<!-- Compile log, Obsidian liquid glass (design canvas board "Compile log + AI diagnostic"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ob_window_bg"
    android:clipChildren="false"
    android:forceDarkAllowed="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ob_log_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/ob_glass"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@id/ig_toolbar_back"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@drawable/ob_press_overlay"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ob_ic_back"
            android:tint="@color/ob_text" />

        <TextView
            android:id="@id/tx_toolbar_title"
            style="@style/Ob.Text.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/ob_log_copy"
            style="@style/Ob.IconPill"
            android:layout_marginRight="6dp"
            android:contentDescription="Copy log"
            android:src="@drawable/ob_ic_copy" />

        <ImageView
            android:id="@+id/ob_log_share"
            style="@style/Ob.IconPill"
            android:layout_marginRight="6dp"
            android:contentDescription="Share log"
            android:src="@drawable/ob_ic_share" />

        <!-- 44dp amber AI pill; 6dp larger each side for its glow. -->
        <ImageView
            android:id="@+id/ob_log_ai"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="-6dp"
            android:layout_marginRight="0dp"
            android:background="@drawable/ob_ai_button"
            android:contentDescription="AI diagnostic"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ob_ic_spark"
            android:stateListAnimator="@animator/sw_press"
            android:tint="@color/ob_accent" />

        <ImageView
            android:id="@id/ig_toolbar_load_file"
            android:layout_width="32dp"
            android:layout_height="44dp"
            android:layout_marginLeft="0dp"
            android:background="@drawable/ob_press_overlay"
            android:contentDescription="Log options"
            android:paddingLeft="6dp"
            android:paddingTop="12dp"
            android:paddingRight="6dp"
            android:paddingBottom="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ob_ic_more"
            android:tint="@color/ob_text_2" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/ob_log_panel">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbarStyle="insideOverlay"
            android:tag="err_vScroll">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="err_hScroll">

                <TextView
                    android:id="@id/tv_compile_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:lineSpacingMultiplier="1.35"
                    android:paddingLeft="14dp"
                    android:paddingTop="14dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="48dp"
                    android:textColor="@color/ob_text_3"
                    android:textColorHighlight="#66FF7A29"
                    android:textSize="11sp" />
            </HorizontalScrollView>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
