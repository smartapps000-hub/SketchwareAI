<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog-style activities (BaseDialogActivity: New Project, Add sound/font/view, ...):
     Obsidian glass sheet with an icon tile, Sora title and pill buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_dialog_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8C000000"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:forceDarkAllowed="false"
    android:paddingLeft="14dp"
    android:paddingRight="14dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ob_dialog_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ob_glass_sheet"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="22dp"
            android:paddingRight="20dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/common_dialog_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/common_dialog_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/ob_tile_orange"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/common_dialog_tv_title"
                    style="@style/Ob.Text.Sheet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/common_dialog_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/common_dialog_button_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/common_dialog_default_button"
                    style="@style/Ob.Text.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/ob_pill16_state"
                    android:ellipsize="end"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:stateListAnimator="@animator/sw_press"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/common_dialog_cancel_button"
                    style="@style/Ob.Text.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/ob_pill16_state"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:stateListAnimator="@animator/sw_press" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- 50dp CTA; reaches 9dp past its slot on each side for the solar glow. -->
                    <TextView
                        android:id="@+id/common_dialog_ok_button"
                        style="@style/Ob.Text.Button.Cta"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="-9dp"
                        android:layout_marginTop="-9dp"
                        android:layout_marginRight="-9dp"
                        android:layout_marginBottom="-9dp"
                        android:background="@drawable/ob_cta_state"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:paddingLeft="19dp"
                        android:paddingRight="19dp"
                        android:singleLine="true"
                        android:stateListAnimator="@animator/sw_press" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
