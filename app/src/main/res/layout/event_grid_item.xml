<?xml version="1.0" encoding="utf-8"?>
<!-- An event tile of the view property panel's Event tab (ViewEvents): dark glass tile, light
     event name. Kept identical in layout/ and layout-v22/. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/container"
    android:layout_width="wrap_content"
    android:layout_height="74.0dip"
    android:layout_marginLeft="4.0dip"
    android:layout_marginTop="4.0dip"
    android:layout_marginRight="4.0dip"
    android:layout_marginBottom="4.0dip"
    android:background="@drawable/ob_tile_state"
    android:gravity="center"
    android:minWidth="96.0dip"
    android:orientation="vertical"
    android:paddingLeft="6.0dip"
    android:paddingRight="6.0dip">

    <RelativeLayout
        android:layout_width="48.0dip"
        android:layout_height="38.0dip">

        <ImageView
            android:id="@id/img_icon"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@id/img_used_event"
            android:layout_width="12.0dip"
            android:layout_height="12.0dip"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:src="@drawable/ic_add_green_circle_24dp" />
    </RelativeLayout>

    <TextView
        android:id="@id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_medium"
        android:includeFontPadding="false"
        android:lines="1"
        android:paddingLeft="4.0dip"
        android:paddingRight="4.0dip"
        android:textColor="@color/ob_text_4"
        android:textSize="12.0sp" />
</LinearLayout>
