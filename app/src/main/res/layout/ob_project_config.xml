<?xml version="1.0" encoding="utf-8"?>
<!-- Project Configuration content (design canvas board "Project Configuration"),
     shown inside the glass dialog (a.a.a.aB). Tagged "obsidian": already designed for glass. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadingEdgeLength="16dp"
    android:overScrollMode="ifContentScrolls"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none"
    android:tag="obsidian">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minimum SDK" />

                <EditText
                    android:id="@+id/ob_cfg_min"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/ob_field"
                    android:fontFamily="@font/manrope_bold"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ob_text"
                    android:textCursorDrawable="@null"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target SDK" />

                <EditText
                    android:id="@+id/ob_cfg_target"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/ob_field_accent"
                    android:fontFamily="@font/manrope_bold"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ob_accent"
                    android:textCursorDrawable="@null"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ob_cfg_target_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/manrope_regular"
            android:includeFontPadding="false"
            android:textColor="@color/ob_text_3"
            android:textSize="12sp" />

        <TextView
            style="@style/Ob.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Application class" />

        <EditText
            android:id="@+id/ob_cfg_app_class"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ob_field"
            android:fontFamily="@font/manrope_regular"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="@color/ob_text"
            android:textColorHint="@color/ob_text_2"
            android:textCursorDrawable="@null"
            android:textSize="16sp" />

        <include
            android:id="@+id/ob_cfg_row_edge"
            layout="@layout/ob_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <include
            android:id="@+id/ob_cfg_row_old"
            layout="@layout/ob_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <include
            android:id="@+id/ob_cfg_row_material"
            layout="@layout/ob_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <include
            android:id="@+id/ob_cfg_row_m3"
            layout="@layout/ob_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <include
            android:id="@+id/ob_cfg_row_heal"
            layout="@layout/ob_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Older projects only (target below 37). -->
        <LinearLayout
            android:id="@+id/ob_cfg_upgrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/ob_pill16"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/ob_cfg_upgrade_title"
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Ob.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Material 3 · target 37 · D8 · Java 11"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ob_cfg_upgrade_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/ob_amber_pill"
                android:fontFamily="@font/manrope_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:stateListAnimator="@animator/sw_press"
                android:text="Convert to Material 3 &amp; Modern Stack"
                android:textColor="@color/ob_accent"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
