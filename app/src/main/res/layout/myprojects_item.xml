<?xml version="1.0" encoding="utf-8"?>
<!-- Project card, Obsidian liquid glass (design canvas board "Projects"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/ob_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ob_glass"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/project_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ob_press_overlay"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/app_icon_layout"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ob_avatar">

                <TextView
                    android:id="@+id/ob_monogram"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sora_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/ob_accent_2"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/img_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/project_name"
                    style="@style/Ob.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/package_name"
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:singleLine="true" />

                <!-- Bound by the adapter; their text is shown in package_name's line. -->
                <TextView
                    android:id="@+id/app_name"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/project_version"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="right|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_published"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="-4dp"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="10dp"
                    android:fontFamily="@font/manrope_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/ob_accent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ob_target_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ob_badge"
                    android:fontFamily="@font/manrope_bold"
                    android:includeFontPadding="false"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="#FFFDBA74"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- The adapter rotates and taps this; the design shows no chevron, so it is
                     invisible and the #id / Target column (and a long press) opens the actions. -->
                <View
                    android:id="@+id/expand"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/project_option_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ob_badge_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ob_badge"
                    android:fontFamily="@font/manrope_semibold"
                    android:includeFontPadding="false"
                    android:paddingLeft="10dp"
                    android:paddingTop="6dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="6dp"
                    android:singleLine="true"
                    android:textColor="@color/ob_accent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ob_badge_build"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/ob_badge"
                    android:fontFamily="@font/manrope_regular"
                    android:includeFontPadding="false"
                    android:paddingLeft="10dp"
                    android:paddingTop="6dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="6dp"
                    android:singleLine="true"
                    android:textColor="@color/ob_text_3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ob_badge_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/ob_badge"
                    android:fontFamily="@font/manrope_regular"
                    android:includeFontPadding="false"
                    android:paddingLeft="10dp"
                    android:paddingTop="6dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="6dp"
                    android:singleLine="true"
                    android:textColor="@color/ob_text_3"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/ob_divider_fade" />

            <LinearLayout
                android:id="@+id/project_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="-3dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
