<?xml version="1.0" encoding="utf-8"?>
<!-- Five-pill action grid of an expanded project card, with its delete confirmation row. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@id/confirm_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="3dp"
        android:paddingRight="3dp">

        <TextView
            android:id="@id/confirm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/manrope_semibold"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/ob_text"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@id/confirm_no"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/ob_pill_state"
            android:gravity="center"
            android:minWidth="84dp"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:stateListAnimator="@animator/sw_press">

            <ImageView
                android:id="@id/confirm_no_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@id/confirm_no_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:textColor="@color/ob_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@id/confirm_yes"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/ob_danger_pill"
            android:gravity="center"
            android:minWidth="84dp"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:stateListAnimator="@animator/sw_press">

            <ImageView
                android:id="@id/confirm_yes_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@id/confirm_yes_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_extrabold"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@id/project_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</FrameLayout>
