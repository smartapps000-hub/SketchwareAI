<?xml version="1.0" encoding="utf-8"?>
<!-- View picker row (VIEW tab): slim obsidian glass pill. The container's 2dp padding shows the
     amber selection colour the activity paints behind the current screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/container"
    android:layout_width="300.0dip"
    android:layout_height="60.0dip"
    android:layout_marginTop="3.0dip"
    android:layout_marginBottom="3.0dip"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="2.0dip">

    <RelativeLayout
        android:layout_width="52.0dip"
        android:layout_height="fill_parent"
        android:background="#FF1E1E22">

        <ImageView
            android:id="@id/img_view"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@id/img_edit"
            android:layout_width="14.0dip"
            android:layout_height="14.0dip"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="3.0dip"
            android:layout_marginRight="3.0dip"
            android:src="@drawable/ic_edit_grey600_24dp"
            android:tint="#FFFFB877" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:layout_weight="1.0"
        android:background="#FF26262B"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="12.0dip"
        android:paddingRight="10.0dip">

        <TextView
            android:id="@id/tv_filename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFF5F5F7"
            android:textSize="14.0sp"
            android:textStyle="bold" />

        <TextView
            android:id="@id/tv_linked_filename"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.0dip"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFA1A1AA"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:background="#FF26262B"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8.0dip"
        android:visibility="gone">

        <ImageView
            android:id="@id/img_preset_setting"
            android:layout_width="22.0dip"
            android:layout_height="22.0dip"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_detail_setting_48dp" />
    </LinearLayout>
</LinearLayout>
