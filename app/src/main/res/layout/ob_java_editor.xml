<?xml version="1.0" encoding="utf-8"?>
<!-- Java editor (v1.8.8, com.sketchware.ai.editor.JavaEditorActivity): an activity's generated Java, editable; Save
     turns the changes back into blocks. Tagged "obsidian": designed for the glass ground. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    android:tag="obsidian">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@+id/je_back"
            style="@style/Ob.IconPill"
            android:contentDescription="Back"
            android:src="@drawable/ob_ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/je_title"
                style="@style/Ob.Text.Screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true" />

            <TextView
                android:id="@+id/je_subtitle"
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/je_undo"
            style="@style/Ob.IconPill"
            android:layout_marginLeft="6dp"
            android:contentDescription="Undo"
            android:src="@drawable/ob_ic_undo" />

        <ImageView
            android:id="@+id/je_redo"
            style="@style/Ob.IconPill"
            android:layout_marginLeft="6dp"
            android:contentDescription="Redo"
            android:src="@drawable/ob_ic_redo" />
    </LinearLayout>

    <TextView
        android:id="@+id/je_banner"
        style="@style/Ob.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/ob_accent_box"
        android:lineSpacingExtra="2dp"
        android:padding="12dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/je_editor_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF121214">

        <ProgressBar
            android:id="@+id/je_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ob_amber" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/je_reset"
            style="@style/Ob.Text.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ob_pill16_state"
            android:stateListAnimator="@animator/sw_press"
            android:text="Reset" />

        <TextView
            android:id="@+id/je_save"
            style="@style/Ob.Text.Button.Cta"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginLeft="12dp"
            android:layout_weight="2"
            android:background="@drawable/ob_cta_state"
            android:stateListAnimator="@animator/sw_press"
            android:text="Save as blocks" />
    </LinearLayout>
</LinearLayout>
