<?xml version="1.0" encoding="utf-8"?>
<!-- One library in the Library Resolver (v1.8.8). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/ob_glass"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp"
    android:tag="obsidian">

    <CheckBox
        android:id="@+id/lib_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:buttonTint="@color/ob_amber"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lib_title"
            style="@style/Ob.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true" />

        <TextView
            android:id="@+id/lib_subtitle"
            style="@style/Ob.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lib_info"
        style="@style/Ob.Text.Button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/ob_pill16_state"
        android:contentDescription="Library info"
        android:gravity="center"
        android:stateListAnimator="@animator/sw_press"
        android:text="i"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lib_action"
        style="@style/Ob.Text.Button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/ob_pill16_state"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:stateListAnimator="@animator/sw_press"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
