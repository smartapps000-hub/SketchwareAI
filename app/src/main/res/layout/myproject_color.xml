<?xml version="1.0" encoding="utf-8"?>
<!-- One project theme colour (New Project / Project settings): swatch with a glass rim and label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/layout_theme_color"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/ob_press_overlay"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingTop="7dp"
    android:paddingRight="5dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/ob_badge"
        android:padding="3dp">

        <TextView
            android:id="@id/color"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_medium"
        android:includeFontPadding="false"
        android:maxWidth="84dp"
        android:singleLine="true"
        android:textColor="@color/ob_text_3"
        android:textSize="10dp" />
</LinearLayout>
