<?xml version="1.0" encoding="utf-8"?>
<!-- Add Component grid cell (6 per row): amber line icon on a small glass tile, compact label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/ob_tile"
    android:foreground="@drawable/ob_press_overlay"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/ob_pill"
        android:contentDescription="@null"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="8.5sp"
        android:autoSizeStepGranularity="0.5sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lines="2"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:textColor="#FFF5F5F7"
        android:textSize="11.5sp" />
</LinearLayout>
