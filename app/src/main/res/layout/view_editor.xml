<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="obsidian">
    <!-- tag "obsidian": the automatic re-colouring of the Event/Component tabs must never touch
         the design canvas, which previews the user's own colours. -->

    <LinearLayout
        android:id="@+id/layout_palette"
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:background="@drawable/ob_glass"
        android:forceDarkAllowed="false"
        android:orientation="vertical"
        android:paddingLeft="3dp"
        android:paddingTop="4dp"
        android:paddingRight="3dp"
        android:paddingBottom="4dp">
        <!-- 6dp margin + 92dp = the 98dp the precompiled ViewEditor reserves for the palette
             (patched from 120dp in app/libs/com.besome.sketch-classes.jar; the preview grows
             by the difference). -->

        <LinearLayout
            android:id="@+id/palette_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.besome.sketch.editor.view.palette.PaletteWidget
                android:id="@+id/palette_widget"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.besome.sketch.editor.view.palette.PaletteFavorite
                android:id="@+id/palette_favorite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/layout_palette"
        android:background="@android:color/transparent"
        android:forceDarkAllowed="false"
        tools:ignore="UnusedAttribute"/>

    <com.besome.sketch.editor.view.ViewDummy
        android:id="@+id/dummy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.besome.sketch.editor.view.ViewProperties
        android:id="@+id/properties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:translationY="150dp" />

    <ImageView
        android:id="@+id/icon_delete"
        android:layout_width="50dp"
        android:layout_height="58dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:contentDescription="@null"
        android:paddingBottom="8dp"
        android:scaleType="fitXY"
        android:src="@drawable/icon_delete"
        android:translationY="66dp" />
</RelativeLayout>
