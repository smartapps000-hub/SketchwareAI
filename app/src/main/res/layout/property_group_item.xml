<?xml version="1.0" encoding="utf-8"?>
<!-- One of the Basic / Recent / Event pills of the view property panel: amber when selected,
     dark glass otherwise (the label colour is set by ObsidianPropertyPanel.tab).
     Kept identical in layout/ and layout-v22/. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/property_group_item"
    android:layout_width="wrap_content"
    android:layout_height="30.0dip"
    android:layout_marginRight="8.0dip"
    android:background="@drawable/ob_seg_pill"
    android:gravity="center"
    android:minWidth="64.0dip"
    android:orientation="horizontal"
    android:paddingLeft="6.0dip"
    android:paddingRight="6.0dip">

    <TextView
        android:id="@id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_bold"
        android:includeFontPadding="false"
        android:lines="1"
        android:paddingLeft="8.0dip"
        android:paddingRight="8.0dip"
        android:textColor="@color/ob_text"
        android:textSize="12.0sp" />
</LinearLayout>
