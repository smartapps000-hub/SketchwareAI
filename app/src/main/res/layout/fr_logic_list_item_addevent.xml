<?xml version="1.0" encoding="utf-8"?>
<!-- Add Event grid tile (up to 6 per row): event icon on a glass pill, target id, event name,
     compact check box in the corner. Ids and view types are the ones AddEventActivity binds. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="80.0dip"
    android:layout_margin="3.0dip"
    android:background="@drawable/ob_tile">

    <LinearLayout
        android:id="@id/events_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="4.0dip"
        android:layout_marginTop="4.0dip"
        android:orientation="horizontal" />

    <CheckBox
        android:id="@id/checkbox"
        android:layout_width="26.0dip"
        android:layout_height="26.0dip"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:buttonTint="@color/ob_accent"
        android:clickable="true"
        android:contentDescription="@null"
        android:minWidth="0.0dip"
        android:minHeight="0.0dip"
        android:scaleX="0.8"
        android:scaleY="0.8" />

    <ImageView
        android:id="@id/img_icon"
        android:layout_width="34.0dip"
        android:layout_height="34.0dip"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8.0dip"
        android:background="@drawable/ob_pill"
        android:contentDescription="@null"
        android:padding="7.0dip" />

    <TextView
        android:id="@id/tv_target_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@id/tv_sep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@id/tv_target_id"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/img_icon"
        android:layout_marginTop="4.0dip"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingLeft="3.0dip"
        android:paddingRight="3.0dip"
        android:singleLine="true"
        android:textColor="@color/ob_text"
        android:textSize="11.0sp"
        android:textStyle="bold" />

    <TextView
        android:id="@id/tv_event_name"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_target_id"
        android:layout_marginTop="2.0dip"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingLeft="3.0dip"
        android:paddingRight="3.0dip"
        android:singleLine="true"
        android:textColor="@color/ob_amber"
        android:textSize="9.5sp" />
</RelativeLayout>
