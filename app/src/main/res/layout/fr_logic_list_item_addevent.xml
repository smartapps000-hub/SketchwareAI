<?xml version="1.0" encoding="utf-8"?>
<!-- Add Event row: one event per line so full names stay visible. Slim glass pill: icon,
     target id over event name, check box on the right. Ids and view types are the ones
     AddEventActivity binds. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="48.0dip"
    android:layout_marginLeft="4.0dip"
    android:layout_marginTop="2.0dip"
    android:layout_marginRight="4.0dip"
    android:layout_marginBottom="2.0dip"
    android:background="@drawable/ob_tile">

    <ImageView
        android:id="@id/img_icon"
        android:layout_width="30.0dip"
        android:layout_height="30.0dip"
        android:layout_centerVertical="true"
        android:layout_marginLeft="8.0dip"
        android:background="@drawable/ob_pill"
        android:contentDescription="@null"
        android:padding="6.0dip" />

    <CheckBox
        android:id="@id/checkbox"
        android:layout_width="32.0dip"
        android:layout_height="32.0dip"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="4.0dip"
        android:buttonTint="@color/ob_accent"
        android:clickable="true"
        android:contentDescription="@null"
        android:minWidth="0.0dip"
        android:minHeight="0.0dip" />

    <TextView
        android:id="@id/tv_target_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@id/tv_sep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="10.0dip"
        android:layout_marginRight="4.0dip"
        android:layout_toLeftOf="@id/checkbox"
        android:layout_toRightOf="@id/img_icon"
        android:orientation="vertical">

        <TextView
            android:id="@id/tv_target_id"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/ob_text"
            android:textSize="13.0sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.0dip"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@id/events_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@id/tv_event_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/ob_amber"
                android:textSize="11.0sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
