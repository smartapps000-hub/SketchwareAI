<?xml version="1.0" encoding="utf-8"?>
<!-- Palette tile content (inflated by the precompiled BaseWidget): icon + label (the palette swaps in line icons where it has them). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/layout_widget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical">

    <ImageView
        android:id="@id/img_widget"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center_vertical"
        />

    <TextView
        android:id="@id/tv_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_semibold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#FFF5F5F7" />
</LinearLayout>
