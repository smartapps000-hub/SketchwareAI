<?xml version="1.0" encoding="utf-8"?>
<!-- New Project screen (v1.8.7, com.sketchware.ai.ui.NewProjectActivity): full screen, Obsidian liquid glass cards.
     Tagged "obsidian": designed for the glass ground, not converted again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    android:tag="obsidian">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/np_back"
            style="@style/Ob.IconPill"
            android:contentDescription="Back"
            android:src="@drawable/ob_ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ob.Text.Screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New project" />

            <TextView
                android:id="@+id/np_subtitle"
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/np_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <!-- 1. Project: names, icon, version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ob_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/np_icon_tile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/ob_avatar"
                        android:contentDescription="App icon"
                        android:stateListAnimator="@animator/sw_press">

                        <ImageView
                            android:id="@+id/np_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ob_app_icon_placeholder" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ob.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Project" />

                        <TextView
                            style="@style/Ob.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tap the tile to choose an app icon" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Application name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/np_ti_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="noExcludeDescendants"
                    android:textColorHint="@color/ob_text_2"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/np_app_name"
                        style="@style/Ob.Field"
                        android:drawableStart="@drawable/np_ic_android"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/ob_accent"
                        android:hint="Enter application name"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Package name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/np_ti_package"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="noExcludeDescendants"
                    android:textColorHint="@color/ob_text_2"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/np_package"
                        style="@style/Ob.Field"
                        android:drawableStart="@drawable/np_ic_package"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/ob_accent"
                        android:inputType="textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Project name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/np_ti_project"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="noExcludeDescendants"
                    android:textColorHint="@color/ob_text_2"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/np_project"
                        style="@style/Ob.Field"
                        android:drawableStart="@drawable/np_ic_shapes"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/ob_accent"
                        android:inputType="textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ob.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Version code" />

                        <EditText
                            android:id="@+id/np_version_code"
                            style="@style/Ob.Field"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="9" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ob.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Version name" />

                        <EditText
                            android:id="@+id/np_version_name"
                            style="@style/Ob.Field"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="40" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Template carousel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ob_glass"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/np_ic_template"
                        android:tint="@color/ob_amber" />

                    <TextView
                        style="@style/Ob.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Template" />
                </LinearLayout>

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="What the first screen starts with. Everything it adds is ordinary views and blocks you can change." />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/np_templates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 3. Build engine -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ob_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/np_ic_engine"
                        android:tint="@color/ob_amber" />

                    <TextView
                        style="@style/Ob.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Build engine" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ob_field"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/np_engine_modern"
                        style="@style/Ob.Text.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/ob_seg_pill"
                        android:text="Modern D8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/np_engine_legacy"
                        style="@style/Ob.Text.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ob_seg_pill"
                        android:text="Legacy Dx"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/np_engine_caption"
                    style="@style/Ob.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- 4. Theme colours, preview, Material 3 options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ob_glass"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ob_ic_material3"
                        android:tint="@color/ob_amber" />

                    <TextView
                        style="@style/Ob.Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:text="Theme" />

                    <LinearLayout
                        android:id="@+id/np_random"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/ob_pill16_state"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="12dp"
                        android:paddingRight="14dp"
                        android:stateListAnimator="@animator/sw_press">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/np_ic_shuffle"
                            android:tint="@color/ob_accent" />

                        <TextView
                            style="@style/Ob.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="Generate random"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/np_palettes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="Project colours (tap one to change it)" />

                <LinearLayout
                    android:id="@+id/np_colors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />

                <com.sketchware.ai.ui.ThemePreviewView
                    android:id="@+id/np_preview"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="16dp" />

                <TextView
                    android:id="@+id/np_preview_caption"
                    style="@style/Ob.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <include
                        android:id="@+id/np_material3"
                        layout="@layout/ob_toggle_row" />

                    <include
                        android:id="@+id/np_dark"
                        layout="@layout/ob_toggle_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <include
                        android:id="@+id/np_dynamic"
                        layout="@layout/ob_toggle_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Build & SDK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ob_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/np_ic_sdk"
                        android:tint="@color/ob_amber" />

                    <TextView
                        style="@style/Ob.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Build and SDK" />
                </LinearLayout>

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Minimum SDK" />

                <TextView
                    android:id="@+id/np_min_sdk"
                    style="@style/Ob.Field"
                    android:drawableEnd="@drawable/ob_ic_chevron_down"
                    android:drawableTint="@color/ob_text_2"
                    android:gravity="center_vertical"
                    android:stateListAnimator="@animator/sw_press" />

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Target SDK" />

                <TextView
                    android:id="@+id/np_target_sdk"
                    style="@style/Ob.Field"
                    android:drawableEnd="@drawable/ob_ic_chevron_down"
                    android:drawableTint="@color/ob_text_2"
                    android:gravity="center_vertical"
                    android:stateListAnimator="@animator/sw_press" />

                <TextView
                    style="@style/Ob.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Java language level" />

                <TextView
                    android:id="@+id/np_java"
                    style="@style/Ob.Field"
                    android:drawableEnd="@drawable/ob_ic_chevron_down"
                    android:drawableTint="@color/ob_text_2"
                    android:gravity="center_vertical"
                    android:stateListAnimator="@animator/sw_press" />

                <TextView
                    android:id="@+id/np_java_caption"
                    style="@style/Ob.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/np_cancel"
            style="@style/Ob.Text.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ob_pill16_state"
            android:stateListAnimator="@animator/sw_press"
            android:text="Cancel" />

        <TextView
            android:id="@+id/np_create"
            style="@style/Ob.Text.Button.Cta"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:background="@drawable/ob_cta_state"
            android:stateListAnimator="@animator/sw_press"
            android:text="Create" />
    </LinearLayout>
</LinearLayout>
