<?xml version="1.0" encoding="utf-8"?>
<!-- Crash report (CollectErrorActivity): Obsidian glass sheet with the cause, the full stack
     trace on demand, and Show error / Copy / Close / Share pills. Uses only plain shapes and
     system fonts so it can always draw, whatever crashed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ob_window_bg"
    android:fitsSystemWindows="true"
    android:forceDarkAllowed="false"
    android:paddingLeft="14dp"
    android:paddingTop="24dp"
    android:paddingRight="14dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ob_safe_sheet"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="22dp"
        android:paddingRight="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ob_safe_tile"
                android:contentDescription="@null"
                android:padding="11dp"
                android:src="@drawable/ob_ic_spark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ob_crash_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Sketchware AI stopped"
                    android:textColor="#FFF5F5F7"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ob_crash_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#FFA1A1AA"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/ob_safe_accent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:text="WHAT HAPPENED"
                android:textColor="#FFFFB877"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ob_crash_cause"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.25"
                android:textColor="#FFF5F5F7"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ob_crash_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#FFE4E4E7"
            android:textSize="14sp" />

        <ScrollView
            android:id="@+id/ob_crash_log_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:background="@drawable/ob_safe_log"
            android:fadeScrollbars="false"
            android:scrollbarStyle="insideOverlay"
            android:visibility="gone">

            <TextView
                android:id="@+id/ob_crash_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:padding="12dp"
                android:textColor="#FFD4D4D8"
                android:textColorHighlight="#66FF7A29"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ob_crash_show"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/ob_safe_pill_state"
                android:gravity="center"
                android:text="Show error"
                android:textColor="#FFF5F5F7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ob_crash_copy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/ob_safe_pill_state"
                android:gravity="center"
                android:text="Copy"
                android:textColor="#FFFFB877"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ob_crash_close"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/ob_safe_pill_state"
                android:gravity="center"
                android:text="Close"
                android:textColor="#FFF5F5F7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ob_crash_share"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/ob_safe_cta_state"
                android:gravity="center"
                android:text="Share report"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
