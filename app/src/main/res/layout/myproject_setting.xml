<?xml version="1.0" encoding="utf-8"?>
<!-- New Project / Project settings content, inside the glass dialog sheet
     (common_dialog_layout). Tagged "obsidian": already designed for glass. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/contents"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:tag="obsidian">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@id/app_icon_layout"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ob_avatar"
                android:stateListAnimator="@animator/sw_press">

                <ImageView
                    android:id="@id/app_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_icon" />
            </FrameLayout>

            <TextView
                android:id="@id/tv_change_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope_medium"
                android:includeFontPadding="false"
                android:textColor="@color/ob_accent_2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

        <TextView
            style="@style/Ob.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@id/ti_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            android:textColorHint="@color/ob_text_2"
            android:importantForAutofill="noExcludeDescendants"
            app:hintTextAppearance="@style/Ob.FieldLabel">

            <EditText
                android:id="@id/et_app_name"
                style="@style/Ob.Field"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@id/basic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@id/advanced_setting"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ob_pill16_state"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:stateListAnimator="@animator/sw_press">

            <TextView
                android:id="@id/tv_advanced_settings"
                style="@style/Ob.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <ImageView
                android:id="@id/icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ob_ic_sliders"
                android:tint="@color/ob_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@id/advanced_setting_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Theme colours" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ob_field"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@id/layout_theme_colors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ImageView
                    android:id="@id/img_theme_color_help"
                    style="@style/Ob.IconPill"
                    android:layout_marginLeft="10dp"
                    android:contentDescription="Theme colour guide"
                    android:src="@drawable/ob_ic_help"
                    android:tint="@color/ob_text" />
            </LinearLayout>

            <ImageView
                android:id="@id/img_color_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:background="@drawable/ob_field"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/color_guide"
                android:visibility="gone" />

            <TextView
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Package name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@id/ti_package_name"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/ob_text_2"
                android:importantForAutofill="noExcludeDescendants"
                app:hintTextAppearance="@style/Ob.FieldLabel">

                <EditText
                    android:id="@id/et_package_name"
                    style="@style/Ob.Field"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Project name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@id/ti_project_name"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/ob_text_2"
                android:importantForAutofill="noExcludeDescendants"
                app:hintTextAppearance="@style/Ob.FieldLabel">

                <EditText
                    android:id="@id/et_project_name"
                    style="@style/Ob.Field"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Ob.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Version code · Version name" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@id/ver_code"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/ob_field"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/ob_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@id/ver_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ob_field"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:text="1.0"
                    android:textColor="@color/ob_text"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
