<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass surface, see com.sketchware.ai.ui.GlassDrawable. -->
<!-- v1.9.7.1: the orange is deepened (was #E8501C to #F97316) so the white label reaches WCAG AA: 4.6:1 along the whole gradient; white on the old gradient was 3.75:1 down to 2.80:1. -->
<drawable xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    class="com.sketchware.ai.ui.GlassDrawable"
    app:swRadius="16dp"
    app:swFillAngle="315"
    app:swFillTop="#FFD34115"
    app:swFillBottom="#FFC64F14"
    app:swRimTop="#B3FFFFFF"
    app:swRimBottom="#52FFFFFF"
    app:swGlowColor="#80FF7428"
    app:swGlowRadius="9dp"
    app:swGlowDy="3dp" />
