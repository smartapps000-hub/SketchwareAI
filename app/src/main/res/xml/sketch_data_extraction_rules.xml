<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.1: the same for Android 12+ (cloud backup and phone-to-phone transfer): the GitHub sign-in, its device-flow
     state, the account card and the one-phone mark stay on the phone that made them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sketchware_ai_github.xml" />
        <exclude domain="sharedpref" path="sketchware_ai_github_signin.xml" />
        <exclude domain="sharedpref" path="sketchware_ai_github_profile.xml" />
        <exclude domain="sharedpref" path="sketchware_ai_device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sketchware_ai_github.xml" />
        <exclude domain="sharedpref" path="sketchware_ai_github_signin.xml" />
        <exclude domain="sharedpref" path="sketchware_ai_github_profile.xml" />
        <exclude domain="sharedpref" path="sketchware_ai_device.xml" />
    </device-transfer>
</data-extraction-rules>
