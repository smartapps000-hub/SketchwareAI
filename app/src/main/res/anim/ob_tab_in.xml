<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.3 (owner's 22 Nov report: lag between Home, Create, Play Store and Community): a tab screen fades in over
     150 ms (Android's own fade is 500 ms; its default screen animation about 400). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="150"
    android:fromAlpha="0.0"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:toAlpha="1.0" />
