<?xml version="1.0" encoding="utf-8"?>
<!-- View property panel (com.besome.sketch.editor.view.ViewProperty), the bottom panel of the
     design screen, in Obsidian glass: the panel itself is the top-rounded glass sheet set on
     @id/view_property in design.xml; here a clear header (widget picker pill + save-to-favourites
     pill), the Basic / Recent / Event pills and the tile strip. Same ids and structure as the
     classic layout: ViewProperty and the precompiled ViewPropertyItems look them up.
     Kept identical in layout/ and layout-v22/. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:paddingTop="8.0dip">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="38.0dip"
        android:gravity="center_vertical"
        android:paddingLeft="12.0dip"
        android:paddingRight="12.0dip">

        <Spinner
            android:id="@id/spn_widget"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:background="@drawable/ob_spinner_bg"
            android:paddingLeft="4.0dip"
            android:paddingRight="32.0dip"
            android:popupBackground="@drawable/ob_popup_bg"
            android:spinnerMode="dropdown" />

        <ImageView
            android:id="@id/img_save"
            android:layout_width="38.0dip"
            android:layout_height="38.0dip"
            android:layout_marginLeft="8.0dip"
            android:background="@drawable/ob_pill_state"
            android:contentDescription="@null"
            android:padding="8.0dip"
            android:scaleType="fitCenter"
            android:src="@drawable/save_white_48"
            android:stateListAnimator="@animator/sw_press"
            android:tint="@color/ob_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@id/layout_property_group"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12.0dip"
        android:paddingRight="12.0dip" />

    <RelativeLayout
        android:id="@id/property_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="horizontal">

        <!-- The tile strip ends where "See All" begins, so no tile shows through or peeks out
             from behind it (on the Recent tab "See All" is gone and the strip takes the full
             width). -->
        <com.besome.sketch.lib.ui.CustomHorizontalScrollView
            android:id="@id/hcv_property"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_toLeftOf="@id/layout_property_see_all"
            android:fadingEdgeLength="14.0dip"
            android:fillViewport="true"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@id/property_contents"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="horizontal"
                android:paddingLeft="8.0dip" />
        </com.besome.sketch.lib.ui.CustomHorizontalScrollView>

        <LinearLayout
            android:id="@id/layout_property_see_all"
            android:layout_width="wrap_content"
            android:layout_height="82.0dip"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:paddingRight="8.0dip" />
    </RelativeLayout>

    <com.besome.sketch.editor.view.ViewEvents
        android:id="@id/view_event"
        android:layout_width="fill_parent"
        android:layout_height="82.0dip" />
</LinearLayout>
