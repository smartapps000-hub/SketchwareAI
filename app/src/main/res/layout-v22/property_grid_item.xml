<?xml version="1.0" encoding="utf-8"?>
<!-- A tile of the view property panel (inject, convert, width, ... and "See All"): dark glass
     tile, light label, amber when pressed. The CardView is kept for the code that looks up
     @id/property_menu_item; it is clear and flat, the tile is drawn by the layout inside it.
     Kept identical in layout/ and layout-v22/. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card="http://schemas.android.com/apk/res-auto"
    android:id="@id/property_menu_item"
    android:layout_width="74.0dip"
    android:layout_height="74.0dip"
    android:layout_margin="4.0dip"
    android:visibility="gone"
    card:cardBackgroundColor="@android:color/transparent"
    card:cardCornerRadius="11.0dip"
    card:cardElevation="0.0dip">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@drawable/ob_tile_state"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@id/img_icon"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip" />

        <TextView
            android:id="@id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingLeft="4.0dip"
            android:paddingRight="4.0dip"
            android:textColor="@color/ob_text_4"
            android:textSize="10.0sp" />

        <TextView
            android:id="@id/tv_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingLeft="4.0dip"
            android:paddingRight="4.0dip"
            android:singleLine="true"
            android:textColor="@color/ob_text_2"
            android:textSize="10.0sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
