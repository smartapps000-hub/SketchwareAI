<?xml version="1.0" encoding="utf-8"?>
<!-- v1.8.7: the owner's NewProject9 main.xml as the generator writes it (TextView, empty LinearLayout, EditText,
     MaterialButton, VideoView, WebView, Button; palette default sizes) inside the generated activity frame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#F4511E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textview1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="TextView"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:padding="8dp" />

        <EditText
            android:id="@+id/edittext1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Edit Text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/materialbutton1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MaterialButton" />

        <VideoView
            android:id="@+id/videoview1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <WebView
            android:id="@+id/webview1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/button1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Button" />
    </LinearLayout>
</LinearLayout>
